#!/usr/bin/env zsh

emulate -L zsh
setopt ERR_EXIT NO_UNSET PIPE_FAIL

script_name="${0:t}"
script_dir="${0:A:h}"
script_path="${0:A}"
flake_path="${script_dir}/nix"
original_args=("$@")

usage() {
  print -u2 "Usage: ${script_name} <overlay-name> [-C repository] -- <command> [args...]"
}

fail() {
  print -u2 "[${script_name}] $*"
  exit 1
}

activate_nix() {
  local nix_profile

  command -v nix >/dev/null 2>&1 && return

  for nix_profile in \
    /nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh \
    "${HOME}/.nix-profile/etc/profile.d/nix.sh"
  do
    if [[ -r "$nix_profile" ]]; then
      source "$nix_profile"
      command -v nix >/dev/null 2>&1 && return
    fi
  done

  fail "Nix is not installed. Run ${script_dir}/bootstrap-nix.sh first."
}

if (( $# < 3 )); then
  usage
  exit 2
fi

overlay_name="$1"
shift

repo_path="."
if [[ "${1:-}" == "-C" ]]; then
  (( $# >= 3 )) || {
    usage
    exit 2
  }
  repo_path="$2"
  shift 2
fi

if [[ "${1:-}" != "--" ]]; then
  usage
  exit 2
fi
shift

if (( $# == 0 )); then
  usage
  exit 2
fi
command_args=("$@")

if [[ "$overlay_name" != [A-Za-z0-9]* \
  || "$overlay_name" == *[^A-Za-z0-9._-]* ]]; then
  fail "Overlay name must start with a letter or number and contain only letters, numbers, dots, underscores, or hyphens."
fi

[[ -f "${flake_path}/flake.nix" ]] \
  || fail "Nix flake not found: ${flake_path}/flake.nix"

if [[ "${NIX_WT_IN_NIX:-0}" != 1 ]]; then
  activate_nix
  exec nix develop "path:${flake_path}" \
    --command env NIX_WT_IN_NIX=1 "$script_path" "${original_args[@]}"
fi

for required_command in cksum flock fuse-overlayfs fusermount3 git mountpoint systemd-run; do
  command -v "$required_command" >/dev/null 2>&1 \
    || fail "Required command not found in the Nix dev shell: ${required_command}"
done
command -v "${command_args[1]}" >/dev/null 2>&1 \
  || fail "Command not found in the Nix dev shell: ${command_args[1]}"

[[ -d "$repo_path" ]] || fail "Repository path not found: ${repo_path}"
repo_root="$(git -C "$repo_path" rev-parse --show-toplevel 2>/dev/null)" \
  || fail "Path is not inside a Git repository: ${repo_path}"
repo_root="${repo_root:A}"

[[ -z "$(git -C "$repo_root" status --porcelain)" ]] \
  || fail "Repository must be clean before creating or reopening an overlay: ${repo_root}"

base_commit="$(git -C "$repo_root" rev-parse HEAD)"
branch_name="user/keegancaruso/${overlay_name}"
git check-ref-format --branch "$branch_name" >/dev/null 2>&1 \
  || fail "Overlay name does not produce a valid Git branch: ${branch_name}"

repo_name="${repo_root:t}"
repo_slug="${repo_name//[^A-Za-z0-9._-]/-}"
repo_slug="${repo_slug[1,48]}"
repo_id="$(print -rn -- "$repo_root" | cksum | awk '{print $1}')"
repo_key="${repo_slug}-${repo_id}"
state_dir="${XDG_STATE_HOME:-${HOME}/.local/state}/nix-wt/${repo_key}/${overlay_name}"
upper_dir="${state_dir}/upper"
work_dir="${state_dir}/work"
merged_dir="${state_dir}/merged"
lower_parent="${repo_root}.worktrees"
lower_dir="${lower_parent}/nix-wt-${overlay_name}"
base_commit_file="${state_dir}/base-commit"
repo_root_file="${state_dir}/repo-root"
lower_dir_file="${state_dir}/lower-dir"
vcs_mode_file="${state_dir}/vcs-mode"
session_lock_file="${state_dir}/session.lock"
lower_staging_dir="${lower_dir}.creating.$$"
scope_name="nix-wt-${repo_key}-${overlay_name}.scope"
(( ${#scope_name} <= 255 )) \
  || fail "Repository and overlay names produce a systemd scope name longer than 255 characters."

mkdir -p "$upper_dir" "$work_dir" "$merged_dir"

exec {session_lock_fd}>"$session_lock_file"
flock -n "$session_lock_fd" \
  || fail "Overlay is already starting or running: ${merged_dir}"

if [[ -f "$repo_root_file" ]]; then
  overlay_repo_root="$(<"$repo_root_file")"
  [[ "$overlay_repo_root" == "$repo_root" ]] \
    || fail "Overlay belongs to ${overlay_repo_root}, not ${repo_root}."
else
  print -r -- "$repo_root" >"$repo_root_file"
fi

create_immutable_lower() {
  local requested_vcs_mode="$1"
  local lower_ready=0
  local origin_url

  [[ ! -e "$lower_dir" ]] \
    || fail "Lower directory already exists without matching overlay state: ${lower_dir}"
  [[ ! -e "$lower_staging_dir" ]] \
    || fail "Lower-directory staging path already exists: ${lower_staging_dir}"
  git -C "$repo_root" cat-file -e "${overlay_base_commit}^{commit}" 2>/dev/null \
    || fail "Overlay base commit is no longer available: ${overlay_base_commit}"

  mkdir -p "$lower_parent"
  cleanup_lower_staging() {
    (( lower_ready )) || rm -rf -- "$lower_staging_dir"
  }
  trap cleanup_lower_staging EXIT

  git clone --quiet --no-hardlinks --no-checkout "$repo_root" "$lower_staging_dir"
  git -C "$lower_staging_dir" checkout --quiet --detach "$overlay_base_commit"

  origin_url="$(git -C "$repo_root" remote get-url origin 2>/dev/null || true)"
  if [[ -n "$origin_url" ]]; then
    git -C "$lower_staging_dir" remote set-url origin "$origin_url"
  fi

  if [[ "$requested_vcs_mode" == "jj" ]]; then
    command -v jj >/dev/null 2>&1 \
      || fail "Jujutsu is required for the source repository: ${repo_root}"
    jj git init --colocate "$lower_staging_dir" >/dev/null
  fi
  vcs_mode="$requested_vcs_mode"

  mv -- "$lower_staging_dir" "$lower_dir"
  lower_ready=1
  trap - EXIT
}

validate_immutable_lower() {
  [[ -d "${lower_dir}/.git" ]] \
    || fail "Overlay lower directory is not a Git checkout: ${lower_dir}"
  [[ "$(git -C "$lower_dir" rev-parse HEAD 2>/dev/null)" == "$overlay_base_commit" ]] \
    || fail "Overlay lower directory is not at the recorded base commit: ${lower_dir}"
}

write_overlay_metadata() {
  local lower_dir_tmp="${lower_dir_file}.tmp.$$"
  local vcs_mode_tmp="${vcs_mode_file}.tmp.$$"

  print -r -- "$lower_dir" >"$lower_dir_tmp"
  print -r -- "$vcs_mode" >"$vcs_mode_tmp"
  mv -- "$lower_dir_tmp" "$lower_dir_file"
  mv -- "$vcs_mode_tmp" "$vcs_mode_file"
}

if [[ -f "$base_commit_file" ]]; then
  overlay_base_commit="$(<"$base_commit_file")"
  if [[ ! -f "$lower_dir_file" || ! -f "$vcs_mode_file" ]]; then
    [[ ! -e "${upper_dir}/.jj" && ! -L "${upper_dir}/.jj" ]] \
      || fail "Legacy overlay contains Jujutsu metadata and cannot be migrated automatically. Reopen it with the original nix-wt version and push its work: ${overlay_name}"
    if [[ -f "$lower_dir_file" ]]; then
      [[ "$(<"$lower_dir_file")" == "$lower_dir" ]] \
        || fail "Overlay lower directory metadata is invalid: ${lower_dir_file}"
    fi
    if [[ -f "$vcs_mode_file" ]]; then
      [[ "$(<"$vcs_mode_file")" == "git" ]] \
        || fail "Legacy overlay VCS metadata is invalid: ${vcs_mode_file}"
    fi

    print "[${script_name}] Migrating legacy overlay to an immutable lower directory"
    if [[ -e "$lower_dir" ]]; then
      validate_immutable_lower
      vcs_mode="git"
    else
      create_immutable_lower git
    fi
    write_overlay_metadata
  else
    [[ -f "$lower_dir_file" && -f "$vcs_mode_file" ]] \
      || fail "Overlay immutable-lower metadata is incomplete: ${state_dir}"
    overlay_lower_dir="$(<"$lower_dir_file")"
    [[ "$overlay_lower_dir" == "$lower_dir" ]] \
      || fail "Overlay lower directory is ${overlay_lower_dir}, expected ${lower_dir}."
    [[ -d "$lower_dir" ]] \
      || fail "Overlay lower directory is missing: ${lower_dir}"
    vcs_mode="$(<"$vcs_mode_file")"
    [[ "$vcs_mode" == "git" || "$vcs_mode" == "jj" ]] \
      || fail "Overlay has an invalid VCS mode: ${vcs_mode}"
  fi
else
  if [[ -d "${repo_root}/.jj" ]]; then
    requested_vcs_mode="jj"
  else
    requested_vcs_mode="git"
  fi
  overlay_base_commit="$base_commit"
  create_immutable_lower "$requested_vcs_mode"
  print -r -- "$base_commit" >"$base_commit_file"
  write_overlay_metadata
fi

mountpoint -q "$merged_dir" \
  && fail "Overlay is already mounted, possibly by another agent: ${merged_dir}"

mounted=0
cleanup() {
  local attempt

  (( mounted )) || return
  cd /

  for attempt in {1..5}; do
    mountpoint -q "$merged_dir" || return
    fusermount3 -u "$merged_dir" 2>/dev/null && return
    sleep 0.1
  done

  print -u2 "[${script_name}] Failed to unmount overlay: ${merged_dir}"
}
trap cleanup EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

fuse-overlayfs \
  -o "lowerdir=${lower_dir},upperdir=${upper_dir},workdir=${work_dir}" \
  "$merged_dir"
mounted=1
mountpoint -q "$merged_dir" || fail "Overlay mount failed: ${merged_dir}"

if [[ "$vcs_mode" == "jj" ]]; then
  jj -R "$merged_dir" bookmark set "$branch_name" -r '@'
  vcs_label="Bookmark"
else
  if git -C "$merged_dir" show-ref --verify --quiet "refs/heads/${branch_name}"; then
    git -C "$merged_dir" switch "$branch_name"
  else
    git -C "$merged_dir" switch -c "$branch_name"
  fi

  current_branch="$(git -C "$merged_dir" symbolic-ref --quiet --short HEAD 2>/dev/null)" \
    || fail "Overlay repository is not on a branch."
  [[ "$current_branch" == "$branch_name" ]] \
    || fail "Overlay uses '${current_branch}', expected '${branch_name}'."
  vcs_label="Branch"
fi

print "[${script_name}] Repository: ${repo_root}"
print "[${script_name}] Lower: ${lower_dir}"
print "[${script_name}] Overlay: ${merged_dir}"
print "[${script_name}] State: ${state_dir}"
print "[${script_name}] ${vcs_label}: ${branch_name}"
print "[${script_name}] Scope: ${scope_name}"
print "[${script_name}] Starting: ${(q)command_args}"

(
  cd "$merged_dir"
  exec systemd-run \
    --user \
    --scope \
    --collect \
    --unit="$scope_name" \
    -- \
    "${command_args[@]}"
)
